NODE_ENV=production
PORT=3001
JWT_SECRET=troque-por-um-segredo-forte
CORS_ORIGIN=https://atosfardamentos.com.br
VITE_API_BASE_URL=https://atosfardamentos.com.br/api
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Opcional. Sem estas variaveis, o sistema continua usando server/atos.db e server/uploads.
APP_DATA_DIR=
APP_DATABASE_PATH=
APP_UPLOADS_DIR=

APP_BRAND_NAME=Atos Fardamentos
APP_SYSTEM_NAME=Atos System
APP_ORDER_PREFIX=ATOS
APP_QUOTE_PREFIX=ORC
APP_SUPPORT_EMAIL=atosfardamentos@gmail.com
APP_META_LEAD_SOURCE=Oryon CRM
VITE_APP_BRAND_NAME=Atos Fardamentos
VITE_APP_SYSTEM_NAME=Atos System
VITE_APP_ORDER_PREFIX=ATOS
VITE_APP_SUPPORT_EMAIL=atosfardamentos@gmail.com
VITE_APP_LOGO_URL=/logo.png
VITE_APP_LOGO_SMALL_URL=/logo-120.png
VITE_APP_LOGO_MEDIUM_URL=/logo-240.png
VITE_APP_LOGO_WHITE_URL=/logo-white.png
VITE_APP_PRINT_LOGO_URL=/atos_logo.png

ADMIN_EMAIL=admin@atos.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_NAME=Administrador atos

EVOLUTION_BASE_URL=http://127.0.0.1:8080
# Tambem aceito quando o mesmo .env da Evolution API for usado:
# SERVER_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
# Tambem aceito: AUTHENTICATION_API_KEY=
EVOLUTION_INSTANCE=AtosVendas
PUBLIC_APP_URL=https://atosfardamentos.com.br
EVOLUTION_WEBHOOK_URL=

DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_HISTORIC=false

META_GRAPH_VERSION=v26.0
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_QUALIFIED_LEAD_EVENT_NAME=Lead
META_QUALIFIED_LEAD_LABELS=Lead Qualificado,Lead Qualificada,Em Produção,Em Producao
# Use quando a Evolution envia webhook apenas com labelId, sem nome da etiqueta.
META_QUALIFIED_LEAD_LABEL_IDS=
META_DEFAULT_COUNTRY_CODE=55
# Use somente para testar no Gerenciador de Eventos da Meta:
# META_TEST_EVENT_CODE=

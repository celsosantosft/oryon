VITE_API_BASE_URL=https://atosfardamentos.com.br/api

ADMIN_EMAIL=admin@atos.com
ADMIN_PASSWORD=troque-por-uma-senha-forte

EVOLUTION_BASE_URL=http://127.0.0.1:8080
